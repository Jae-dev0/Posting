DOCKER_APP_PORT=3000

VITE_APP_API_URL=http://localhost

VITE_APP_KEYCLOAK_URL=
VITE_APP_KEYCLOAK_REALM=
VITE_APP_KEYCLOAK_CLIENT_ID=

# Set to "true" to bypass Keycloak auth during local development.
# This lets FE devs work on UI even when Keycloak is down.
# Only works in dev mode (pnpm dev), never in production builds.
VITE_APP_AUTH_BYPASS=false

