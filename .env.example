DOCKER_APP_PORT=3000
POSTGRES_PORT=5432
API_PORT=3001
SEED_DATABASE=true
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# For `pnpm dev` against a Docker API on the host:
VITE_APP_API_URL=http://localhost:3001
# Docker `web` service ignores this and uses same-origin `/api` via nginx.

# Placeholder values — required even when AUTH_BYPASS is true (Keycloak client is still constructed at import time).
VITE_APP_KEYCLOAK_URL=http://localhost:8080
VITE_APP_KEYCLOAK_REALM=master
VITE_APP_KEYCLOAK_CLIENT_ID=dev-client

# Set to "true" to bypass backend auth during local UI development.
# When false, use login against the posting API.
VITE_APP_AUTH_BYPASS=false

# Meta / Facebook (API container / backend/.env — never expose App Secret to Vite)
FRONTEND_URL=http://localhost:5173
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3001/api/social/facebook/callback
META_GRAPH_API_VERSION=v22.0
META_OAUTH_SCOPES=public_profile,pages_show_list,pages_read_engagement,pages_manage_posts,pages_read_user_content
# Instagram via Facebook Login — scopes must match Meta Use cases
META_INSTAGRAM_OAUTH_SCOPES=instagram_basic,instagram_content_publish,pages_show_list,pages_read_engagement,business_management,public_profile
# PUBLIC_API_BASE_URL=https://xxxx.ngrok-free.app
# TOKEN_ENCRYPTION_KEY=  # optional 64-char hex
