PORT=3001
DATABASE_URL=postgresql://posting:posting@localhost:5432/posting
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000
NODE_ENV=development
JWT_SECRET=dev-only-change-me-in-production
JWT_EXPIRES_IN=7d
# After OAuth, Meta redirects here. Use :3000 for Docker web, :5173 for `pnpm dev`.
FRONTEND_URL=http://localhost:3000
# Optional 64-char hex (32 bytes). If omitted, derived from JWT_SECRET (dev only).
# TOKEN_ENCRYPTION_KEY=

# Meta / Facebook Graph API (server-side only — never put App Secret in Vite)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3001/api/social/facebook/callback
META_GRAPH_API_VERSION=v22.0
META_OAUTH_SCOPES=public_profile,pages_show_list,pages_read_engagement,pages_manage_posts,pages_read_user_content
# Instagram via Facebook Login (API setup with Facebook login)
META_INSTAGRAM_OAUTH_SCOPES=instagram_basic,instagram_content_publish,pages_show_list,pages_read_engagement,business_management,public_profile
# PUBLIC_API_BASE_URL=https://xxxx.ngrok-free.app

# TikTok Login Kit + Content Posting API (server-side only).
# TikTok web redirect URIs must be HTTPS and match the developer portal exactly.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-api.example.com/api/social/tiktok/callback
TIKTOK_OAUTH_SCOPES=user.info.basic,video.publish
