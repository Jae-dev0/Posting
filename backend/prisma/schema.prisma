generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SocialPlatform {
  facebook
  instagram
  tiktok
}

enum MediaType {
  image
  video
}

enum PublishMode {
  now
  schedule
  draft
}

enum PostStatus {
  draft
  scheduled
  pending_approval
  published
  failed
  cancelled
}

/// Marketing roles (unchanged). Platform/CMS roles live in Role + UserRoleAssignment.
enum UserRole {
  main_admin
  admin
}

enum CompanyStatus {
  active
  disabled
}

enum UserStatus {
  active
  disabled
}

enum RoleScope {
  platform
  company
}

enum WebsiteAccessMode {
  all_websites
  selected_websites
}

enum PageStatus {
  draft
  published
  archived
}

model Company {
  id                 Int                  @id @default(autoincrement())
  name               String
  domain             String?
  status             CompanyStatus        @default(active)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  users              User[]
  connectedAccounts  ConnectedAccount[]
  socialAccounts     SocialAccount[]
  posts              Post[]
  auditLogs          AuditLog[]
  accountPermissions AccountPermission[]
  websites           Website[]
  pages              Page[]
  websiteSections    WebsiteSection[]
  cmsMedia           CmsMedia[]
  websiteSettings    WebsiteSetting[]
  navigationItems    NavigationItem[]
  roleAssignments    UserRoleAssignment[]
  roles              Role[]

  @@map("companies")
}

model User {
  id                 Int                  @id @default(autoincrement())
  email              String               @unique
  passwordHash       String
  firstName          String
  lastName           String
  role               UserRole             @default(admin)
  status             UserStatus           @default(active)
  companyId          Int
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  socialAccounts     SocialAccount[]
  posts              Post[]               @relation("PostCreator")
  auditLogs          AuditLog[]
  accountPermissions AccountPermission[]
  roleAssignments    UserRoleAssignment[]
  websiteAccessMode  WebsiteAccessMode    @default(all_websites)
  websiteAccesses    UserWebsiteAccess[]
  pagesCreated       Page[]               @relation("PageCreatedBy")
  pagesUpdated       Page[]               @relation("PageUpdatedBy")
  mediaUploaded      CmsMedia[]           @relation("MediaUploadedBy")

  @@index([companyId])
  @@map("users")
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model Role {
  id          Int                  @id @default(autoincrement())
  name        String               @unique
  description String?
  scope       RoleScope
  companyId   Int?
  company     Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isSystem    Boolean              @default(false)
  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@index([companyId])
  @@map("roles")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Platform roles use companyId = null. Company CMS roles require companyId.
model UserRoleAssignment {
  id        Int      @id @default(autoincrement())
  userId    Int
  roleId    Int
  companyId Int?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId, companyId])
  @@index([userId])
  @@index([companyId])
  @@map("user_roles")
}

model Website {
  id          Int       @id @default(autoincrement())
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  domain      String?
  isPrimary   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  pages       Page[]
  sections    WebsiteSection[]
  settings    WebsiteSetting[]
  navigation  NavigationItem[]
  media       CmsMedia[]
  userAccesses UserWebsiteAccess[]

  @@index([companyId])
  @@map("websites")
}

/// Explicit website access for a company user whose access mode is selected_websites.
model UserWebsiteAccess {
  userId    Int
  websiteId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, websiteId])
  @@index([websiteId])
  @@map("user_website_access")
}

model Page {
  id          Int        @id @default(autoincrement())
  companyId   Int
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  websiteId   Int
  website     Website    @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  content     String     @default("")
  status      PageStatus @default(draft)
  createdById Int?
  createdBy   User?      @relation("PageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById Int?
  updatedBy   User?      @relation("PageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  sections    WebsiteSection[]

  @@unique([websiteId, slug])
  @@index([companyId])
  @@map("pages")
}

model WebsiteSection {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  websiteId Int
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  pageId    Int?
  page      Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key       String
  title     String?
  content   String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([pageId])
  @@map("website_sections")
}

model CmsMedia {
  id           Int      @id @default(autoincrement())
  companyId    Int
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  websiteId    Int?
  website      Website? @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  url          String
  uploadedById Int?
  uploadedBy   User?    @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
  @@unique([companyId, filename])
  @@map("cms_media")
}

model WebsiteSetting {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  websiteId Int
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([websiteId, key])
  @@index([companyId])
  @@map("website_settings")
}

model NavigationItem {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  websiteId Int
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  label     String
  href      String
  sortOrder Int      @default(0)
  parentId  Int?
  parent    NavigationItem?  @relation("NavChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  NavigationItem[] @relation("NavChildren")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([websiteId])
  @@map("navigation_items")
}

model ConnectedAccount {
  id            Int                 @id @default(autoincrement())
  companyId     Int
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  platform      SocialPlatform
  accountName   String
  handle        String
  isConnected   Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  posts         PostAccount[]
  socialAccount SocialAccount?
  permissions   AccountPermission[]

  @@unique([companyId, platform, handle])
  @@index([companyId])
  @@map("connected_accounts")
}

/// Encrypted Meta/Facebook (and future platform) connections — company-isolated.
model SocialAccount {
  id                 Int               @id @default(autoincrement())
  companyId          Int
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectedByUserId  Int?
  connectedByUser    User?             @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)
  connectedAccountId Int?              @unique
  connectedAccount   ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  platform           SocialPlatform
  facebookUserId     String?
  pageId             String
  pageName           String
  accessTokenEnc     String
  tokenExpiresAt     DateTime?
  isConnected        Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([companyId, platform, pageId])
  @@index([companyId])
  @@map("social_accounts")
}

model Post {
  id             Int            @id @default(autoincrement())
  companyId      Int
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById    Int?
  createdBy      User?          @relation("PostCreator", fields: [createdById], references: [id], onDelete: SetNull)
  caption        String
  mediaUrl       String?
  mediaType      MediaType?
  publishMode    PublishMode
  status         PostStatus
  scheduledAt    DateTime?
  publishedAt    DateTime?
  externalPostId String?
  publishError   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  accounts       PostAccount[]
  media          PostMedia[]

  @@index([companyId])
  @@index([externalPostId])
  @@map("posts")
}

/// Ordered media attached to a marketing post. A post is either an image gallery
/// (up to ten records) or a single video record.
model PostMedia {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  type      MediaType
  position  Int
  createdAt DateTime  @default(now())

  @@unique([postId, position])
  @@index([postId])
  @@map("post_media")
}

model PostAccount {
  postId    Int
  accountId Int
  post      Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  account   ConnectedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([postId, accountId])
  @@map("post_accounts")
}

/// Who can publish to which connected page/account within a company.
model AccountPermission {
  id                 Int              @id @default(autoincrement())
  companyId          Int
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId             Int
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccountId Int
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  canPublish         Boolean          @default(true)
  canApprove         Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([userId, connectedAccountId])
  @@index([companyId])
  @@map("account_permissions")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  companyId  Int
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   Int?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@map("audit_logs")
}
